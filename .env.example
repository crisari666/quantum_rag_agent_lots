# Comma-separated partner site origins that receive ONLY externalDistribution projects on GET /rag/projects.
# Use the browser Origin (scheme + host, no path/trailing slash) of the Lovable or partner SPA.
# Examples: published custom domain, Lovable publish host, local Vite preview.
# EXTERNAL_DISTRIBUTION_ORIGINS=https://gtower.cloud,https://your-app.lovable.app,http://localhost:8080
EXTERNAL_DISTRIBUTION_ORIGINS=https://partner-a.com,https://partner-b.com

# Agent chat LLM (DeepSeek OpenAI-compatible API)
DEEPSEEK_API_KEY=

# Still required for Weaviate text2VecOpenAI + document ingestion embeddings
OPENAI_API_KEY=

# Mapbox Search Box (server-side POI discovery for project experience)
MAPBOX_ACCESS_TOKEN=

# Public origin saved on experience resource/asset file URLs (no trailing slash).
# Production MUST set this (e.g. https://back.laceiba.group). When unset, local
# default is http://localhost:$PORT_APP — that breaks browsers on remote CRM/studio.
# Localhost URLs are treated as non-public and rebuilt from the file name.
EXPERIENCE_UPLOADS_PUBLIC_BASE=

